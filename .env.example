# Kanban Code — variables de entorno
# Copia este archivo a .env.kanban y completa tus credenciales

# Puerto del servidor backend (default: 3001)
PORT=3001

# Directorio base del workspace Kanban
# Por defecto: ~/.kanban
KANBAN_WORKSPACE=~/.kanban

# Proyecto activo por defecto
KANBAN_PROJECT=mi-proyecto

# Amazon Bedrock — autenticación AWS
# Opción A: perfil AWS (recomendado)
AWS_PROFILE=bedrock-claude
AWS_REGION=us-east-1

# Opción B: access keys directas (alternativa a AWS_PROFILE)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Modelo de Bedrock a usar
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-6

# Modo mock: true = sin llamadas reales a Bedrock (útil para desarrollo)
BEDROCK_MOCK=false

# Motor del agente: bedrock (tool-use manual) | claude-code (Claude Code SDK)
# claude-code usa el binario `claude` instalado localmente — requiere Claude Code instalado
# bedrock usa @aws-sdk/client-bedrock-runtime con ConverseCommand
AGENT_ENGINE=claude-code

# (Opcional) Ruta al binario de Claude Code si no está en PATH
# CLAUDE_BIN=/opt/homebrew/bin/claude

# URL del frontend (para CORS)
FRONTEND_URL=http://localhost:5173

# URL de la API (usada por el frontend Vite)
VITE_API_URL=http://localhost:3001/api

# URL del WebSocket
VITE_WS_URL=ws://localhost:3001/ws
