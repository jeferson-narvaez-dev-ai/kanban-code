# Kanban Code — variables de entorno
# Copia este archivo a .env.kanban y completa tus credenciales

# Puerto del servidor backend (default: 3001)
PORT=3001

# Directorio base del workspace Kanban
# Por defecto: ~/.kanban
KANBAN_WORKSPACE=~/.kanban

# Proyecto activo por defecto
KANBAN_PROJECT=mi-proyecto

# Amazon Bedrock — credenciales AWS
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Modelo de Bedrock a usar
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0

# Modo mock: true = sin llamadas reales a Bedrock (útil para desarrollo)
BEDROCK_MOCK=false

# URL del frontend (para CORS)
FRONTEND_URL=http://localhost:5173

# URL de la API (usada por el frontend Vite)
VITE_API_URL=http://localhost:3001/api

# URL del WebSocket
VITE_WS_URL=ws://localhost:3001/ws
